# Copier vers .env et remplir (ne pas committer .env)

# Supabase — Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Groq — démo invité uniquement (la clé part au navigateur : réservé au dev / démo)
VITE_OWNER_GROQ_KEY=

# Optionnel — limites invité & affichage tokens
 VITE_GUEST_MAX=3
 VITE_GUEST_MODEL=llama-3.3-70b-versatile
 VITE_GUEST_MAX_TOKENS=400
 VITE_DAILY_TOKEN_CAP=500000
